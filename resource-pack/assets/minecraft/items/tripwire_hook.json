{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "scp914_key",
        "model": {
          "type": "minecraft:model",
          "model": "scp:entity/scp914_key"
        }
      },
      {
        "when": "scp914_key_turned",
        "model": {
          "type": "minecraft:model",
          "model": "scp:entity/scp914_key_turned"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/tripwire_hook"
    }
  }
}
